# Patient frontend (Vercel runtime config endpoint)
# FastAPI backend
SUPABASE_URL=https://huwluahlemcyzujoulxp.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_publishable_or_anon_key
# Server-only; never use in VITE_ variables and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL connection string from Supabase Dashboard > Connect. Use the async SQLAlchemy driver.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.huwluahlemcyzujoulxp.supabase.co:5432/postgres
APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=https://your-patient-domain.example,https://your-doctor-domain.example

# Vercel proxy target: deployed FastAPI base URL, without trailing /api
HC_API_BASE_URL=https://your-fastapi-service.example.com
