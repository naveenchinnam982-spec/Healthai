# ── HealthContinuum AI — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=HealthContinuum AI
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# ── Database ─────────────────────────────────────────────────────────────────
# For local development we use SQLite (no server needed).
# Local-only default. Production MUST set DATABASE_URL to Supabase PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./healthcontinuum.db

# Supabase PostgreSQL (production; copy the URI from Supabase Dashboard > Connect)
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.huwluahlemcyzujoulxp.supabase.co:5432/postgres

# ── Supabase (production) ───────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,file://

# ── Doctor Access Codes ───────────────────────────────────────────────────────
ACCESS_CODE_EXPIRE_MINUTES=10

# ── Storage (future) ──────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
